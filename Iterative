# Iterative Factorial Function
def factorial_iterative(n):
    fact = 1

    for i in range(1, n + 1):
        fact = fact * i

    return fact


# Take input
n = int(input("Enter a number: "))

# Calculate factorial
result = factorial_iterative(n)

# Display result
print("Factorial using Iterative Method:", result)

